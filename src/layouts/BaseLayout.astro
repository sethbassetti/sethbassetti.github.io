---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";
import "@fontsource-variable/inter";

const { pageTitle } = Astro.props;
---

<html lang="en" class="">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <ClientRouter />
  </head>

  <!-- 1) Make body a flex container, full height, and position relative. -->
  <body class="relative flex flex-col min-h-screen bg-primary">
    <!-- 2) Absolutely positioned background anchored to body (which is now relative). -->
    <div
      class="absolute inset-0 -z-20 opacity-80 bg-[url('../images/noisy.png')] mix-blend-overlay"
    >
    </div>

    <!-- Header -->
    <Header />

    <!-- 3) Main content grows to push the footer to the bottom. -->
    <main class="flex-grow container px-5 m-auto max-w-screen-xl overflow-hidden sm:px-12 md:px-20">
      <slot />
    </main>

    <!-- Footer at the bottom -->
    <Footer />
  </body>
</html>

<script>
  import "../scripts/themeToggle.js";
</script>
