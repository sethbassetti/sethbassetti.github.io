---
import { Image } from "astro:assets";
import logo from "../images/logo.png";
import ThemeSwitcher from "./ThemeSwitcher.astro";
import "../styles/global.css";
import MobileNav from "./MobileNav.astro";

const navLinks = [
  { name: "HOME", url: "/" },
  { name: "PUBLICATIONS", url: "/publications" },
];

const currentPath = Astro.url.pathname;
---

<header
  class="container h-32 px-5 m-auto max-w-screen-xl overflow-hidden sm:px-12 md:px-20"
>
  <navbar
    class="flex items-center h-full mt-auto space-x-6 text-sm"
    aria-label="Main Navigation"
  >
    <!-- Left Section (Logo/Brand) -->
    <a
      href="/"
      class="flex items-center flex-shrink-0 group"
      aria-label="Website logo, goes back to homepage"
    >
      <Image
        src={logo}
        alt="Logo"
        class="h-9 w-9 rounded-full hover:-translate-y-1 ease-in-out transition-transform focus:-translate-y-1"
        transition:animate="fade"
        id="logo"
        loading="eager"
      />
      <span
        class="text-secondary-content font-semibold ml-3 text-base group-hover:text-accent-content sm:hidden"
        >Seth Bassetti</span
      >
    </a>

    <!-- Center Section (NavLinks) -->
    <div class="hidden sm:flex flex-grow items-center">
      <ul class="flex gap-6">
        {
          navLinks.map((link) => (
            <li
              class={
                "inline-block text-sm tracking-wide font-medium hover:text-accent-content " +
                (currentPath === link.url
                  ? "text-accent-content"
                  : "text-secondary-content")
              }
            >
              <a href={link.url}>{link.name}</a>
            </li>
          ))
        }
      </ul>
      <hr class="flex-1 bg-slate-300 text-slate-300 h-0.5 mx-3 self-center" />
      <ThemeSwitcher />
    </div>
    <MobileNav />
  </navbar>
</header>
