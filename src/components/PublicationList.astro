---
import { getCollection } from "astro:content";
import Publication from "../components/Publication.astro";

const { selected = false } = Astro.props;

// Fetch all papers
const allPapers = await getCollection("papers");

// Filter out papers based on whether we are choosing selected papers
const selectedPapers = allPapers.filter(
  (paper) => !selected || paper.data.selected
);

// Sort papers by descending year
const sortedPapers = selectedPapers.sort((a, b) => b.data.year - a.data.year);

// Group papers by year
const papersByYear = sortedPapers.reduce((acc: any, paper) => {
  const { year } = paper.data;
  if (!acc[year]) {
    acc[year] = [];
  }
  acc[year].push(paper);
  return acc;
}, {});
---

<section class="mt-3">
  {/** Iterate over each year (descending) */}
  {
    Object.keys(papersByYear)
      .sort((a, b) => Number(b) - Number(a))
      .map((year) => (
        <div class="relative mt-8">
          {/* Horizontal line separating each year */}
          <hr class="border-t-2 border-dotted border-gray-300 mb-2" />
          {/* Year label on the right */}
          <span class="absolute right-0 -top-3 text-gray-500 bg-gray-100 px-2">
            {year}
          </span>
          {/* Publications for this year */}
          {papersByYear[year].map((paper: any) => (
            <div class="mb-4">
              <Publication paper={paper.data} />
            </div>
          ))}
        </div>
      ))
  }
</section>
