---
import { getAllPublications } from "../scripts/publications";
import type { Publication } from "../types/publication";

// Prop: optionally filter to only "selected" publications
const { selectedOnly = false } = Astro.props;
const publications = await getAllPublications();

// Filter publications if selectedOnly is true
const filteredPubs = selectedOnly
  ? publications.filter((pub) => pub.selected)
  : publications;

// Group publications by year
const groupedPubs: Record<number, Publication[]> = filteredPubs.reduce(
  (acc, pub) => {
    if (!acc[pub.year]) {
      acc[pub.year] = [];
    }
    acc[pub.year].push(pub);
    return acc;
  },
  {} as Record<number, Publication[]>
);

// Sort years in descending order
const years = Object.keys(groupedPubs)
  .map(Number)
  .sort((a, b) => b - a);
---

<section>
  <div class="mt-3">
    {
      years.map((year, yearIndex) => {
        return (
          <div>
            {yearIndex !== 0 && <hr class="border-back-subtle my-6" />}
            <div class="grid grid-cols-[1fr_80px] gap-8">
              <div class="border-back-subtle space-y-8">
                {groupedPubs[year].map((pub, index) => (
                  <li class="group list-none">
                    <div>
                      <div class="flex items-start gap-8 mb-1">
                        <span class="text-lg font-semibold group-hover:text-accent-content leading-tight">
                          {pub.title}
                        </span>
                      </div>
                      <p class="text-sm text-fore-subtle">
                        {pub.authors.map((author, i) => (
                          <>
                            {i > 0 && ", "}
                            {author.includes("Seth Bassetti") ? (
                              <span class="underline font-bold">{author}</span>
                            ) : (
                              <span>{author}</span>
                            )}
                          </>
                        ))}
                      </p>
                      <p class="text-sm italic text-fore-subtle">{pub.venue}</p>
                      <div class="mt-1 space-x-4">
                        {pub.abbr && (
                          <span class="inline-block px-2 py-1 text-xs border border-accent font-medium bg-accent text-white rounded">
                            {pub.abbr}
                          </span>
                        )}
                        {pub.pdf && (
                          <a
                            href={pub.pdf}
                            class="inline-block px-2 py-1 text-xs border border-accent text-accent hover:bg-accent hover:text-white rounded transition-colors"
                            target="_blank"
                          >
                            PDF
                          </a>
                        )}
                        {pub.url && !pub.pdf && (
                          <a
                            href={pub.url}
                            class="inline-block px-3 py-1 text-sm border border-accent text-accent hover:bg-accent hover:text-white rounded transition-colors"
                            target="_blank"
                          >
                            PDF
                          </a>
                        )}
                      </div>
                    </div>
                  </li>
                ))}
              </div>
              <div class="text-3xl text-fore-subtle text-right opacity-20">
                {year}
              </div>
            </div>
          </div>
        );
      })
    }
  </div>
</section>
